{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inspector-ai.local/schemas/matrix-steel-execution-v1",
  "$ref": "#/definitions/comparisons",
  "title": "KR-056 scoped steel typed execution contract v1",
  "definitions": {
    "loaderPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "objectId",
        "inputManifestHash",
        "sources",
        "origins",
        "applicabilityDecisions",
        "identities"
      ],
      "properties": {
        "schemaVersion": {
          "const": "matrix-kr056-steel-loader-inputs-v1"
        },
        "objectId": {
          "$ref": "matrix-steel-comparison.schema.json#/definitions/key"
        },
        "inputManifestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "sources": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "matrix-steel-comparison.schema.json#/definitions/source"
          }
        },
        "origins": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "matrix-steel-comparison.schema.json#/definitions/origin"
          }
        },
        "applicabilityDecisions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "matrix-steel-comparison.schema.json#/definitions/applicabilityDecision"
          }
        },
        "identities": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "matrix-steel-comparison.schema.json#/definitions/identity"
          }
        }
      }
    },
    "executionResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "id",
            "ruleId",
            "ruleVersion",
            "parameterCode",
            "comparisonVariant",
            "kind",
            "identity",
            "comparison"
          ],
          "properties": {
            "schemaVersion": {
              "const": "matrix-steel-execution-result-v1"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "ruleId": {
              "const": "matrix-kr-056-reviewed_steel_catalog_transition"
            },
            "ruleVersion": {
              "const": "1"
            },
            "parameterCode": {
              "const": "KR-056"
            },
            "comparisonVariant": {
              "const": "PD_RD"
            },
            "kind": {
              "const": "SCOPED_COMPARISON"
            },
            "identity": {
              "$ref": "matrix-steel-comparison.schema.json#/definitions/identity"
            },
            "comparison": {
              "$ref": "matrix-steel-comparison.schema.json#/definitions/result"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "id",
            "ruleId",
            "ruleVersion",
            "parameterCode",
            "comparisonVariant",
            "kind",
            "reasonCode",
            "calibratedProbability"
          ],
          "properties": {
            "schemaVersion": {
              "const": "matrix-steel-execution-result-v1"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "ruleId": {
              "const": "matrix-kr-056-reviewed_steel_catalog_transition"
            },
            "ruleVersion": {
              "const": "1"
            },
            "parameterCode": {
              "const": "KR-056"
            },
            "comparisonVariant": {
              "const": "PD_RD"
            },
            "kind": {
              "const": "UNBOUND_ATOM_ABSTENTION"
            },
            "reasonCode": {
              "const": "REVIEWED_STEEL_DECLARATION_IDENTITY_MISSING"
            },
            "calibratedProbability": {
              "const": null
            }
          }
        }
      ]
    },
    "comparisons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "purpose",
        "objectId",
        "inputManifestHash",
        "capabilityRegistryHash",
        "results"
      ],
      "properties": {
        "schemaVersion": {
          "const": "matrix-steel-comparisons-v1"
        },
        "purpose": {
          "const": "MACHINE_COMPARISON"
        },
        "objectId": {
          "$ref": "matrix-steel-comparison.schema.json#/definitions/key"
        },
        "inputManifestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "capabilityRegistryHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/executionResult"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultId",
        "role",
        "sourceFileId",
        "sourceSha256",
        "reviewDecisionId",
        "reviewContentHash",
        "target",
        "applicabilityDecisionId",
        "applicabilityDecisionContentHash",
        "pageNumber",
        "pageFrame",
        "fragmentRole",
        "fragment"
      ],
      "properties": {
        "resultId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "role": {
          "enum": [
            "EXPECTED",
            "ACTUAL"
          ]
        },
        "sourceFileId": {
          "$ref": "matrix-steel-comparison.schema.json#/definitions/key"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "reviewDecisionId": {
          "$ref": "matrix-steel-comparison.schema.json#/definitions/key"
        },
        "reviewContentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "target": {
          "$ref": "matrix-steel-comparison.schema.json#/definitions/target"
        },
        "applicabilityDecisionId": {
          "$ref": "matrix-steel-comparison.schema.json#/definitions/key"
        },
        "applicabilityDecisionContentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "pageFrame": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "widthMilliPoints",
            "heightMilliPoints"
          ],
          "properties": {
            "widthMilliPoints": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "heightMilliPoints": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "fragmentRole": {
          "enum": [
            "PRIMARY",
            "DECLARATION_SCOPE",
            "PHYSICAL_MEMBER_SCOPE",
            "APPLICABILITY_BASIS"
          ]
        },
        "fragment": {
          "$ref": "matrix-steel-comparison.schema.json#/definitions/fragment"
        }
      }
    },
    "coverageRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameterCode",
        "implementedAtomicRules",
        "enabledAtomicRules",
        "evaluatedAtomicRules",
        "successfulComparisons",
        "abstentions",
        "failures",
        "executionStatus",
        "reason"
      ],
      "properties": {
        "parameterCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "implementedAtomicRules": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "enabledAtomicRules": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluatedAtomicRules": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "successfulComparisons": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "abstentions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executionStatus": {
          "enum": [
            "UNSUPPORTED",
            "PARTIAL",
            "EVALUATED",
            "TECHNICAL_FAILURE"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 2000000
        }
      }
    }
  },
  "x-local-ref-allowlist": [
    "matrix-steel-comparison.schema.json"
