        "identity": {
          "$ref": "#/$defs/identity"
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        },
        "expertReviewRequired": {
          "const": true
        },
        "calibratedProbability": {
          "type": "null"
        }
      }
    },
    "noDecreaseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "reasonCode",
        "identity",
        "comparison",
