# Template for infra/.env.server. `./infra/stack.sh server init` fills secrets.
HOST_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=inspector
POSTGRES_USER=inspector
POSTGRES_PASSWORD=generated-by-stack-sh
RABBITMQ_USER=inspector
RABBITMQ_PASSWORD=generated-by-stack-sh
REDIS_PASSWORD=generated-by-stack-sh
MINIO_ROOT_USER=inspector
MINIO_ROOT_PASSWORD=generated-by-stack-sh
INTERNAL_WORKER_TOKEN=replace-with-random-worker-token-32chars
INSPECTOR_ANALYSIS_PROFILE=SCAFFOLD
# Keep V4 unless explicitly evaluating H100 V6 visual hints.
INSPECTOR_VISUAL_PROFILE=V4
# Optional v2/v3/v4 for a new PILOT_PZ002_PZ017 run after API and worker are updated together.
INSPECTOR_OCR_LAYOUT_SELECTION_PROFILE=v1
# Optional review aid for the PZ-017 pilot; requires OCR v3 or v4 and never creates findings.
# INSPECTOR_OCR_HEAT_ROW_PROFILE=v1
# Optional five-rule review aid; requires OCR heat v1 and OCR layout v3 or v4.
# INSPECTOR_FACT_FAMILY_PROFILE=v1
# Optional 47-code lexical navigation preview; requires fact family v1.
# All rows abstain and do not change findings or parameter coverage.
# INSPECTOR_CANDIDATE_FAMILY_PREVIEW_PROFILE=v1
# Optional verified observations from the preview; still review-only.
# INSPECTOR_CANDIDATE_FAMILY_OBSERVATIONS_PROFILE=v1
# INSPECTOR_CANDIDATE_FAMILY_OCR_OBSERVATIONS_PROFILE=v1
# Optional uncoded OCR table rows; requires candidate OCR observations v1 and bounded OCR v4/v5.
# INSPECTOR_OCR_TABLE_ROWS_PROFILE=v1  # opt-in; v2/v3 also available
# INSPECTOR_OCR_TYPED_FACT_CANDIDATE_PROFILE=v1  # opt-in review artifact; requires OCR table rows
# INSPECTOR_UNRESOLVED_FAMILY_RUN_REVIEW_PROFILE=v1  # opt-in AR-042/IOS2-072/IOS3-075 text review; requires OCR table rows v3
# INSPECTOR_UNRESOLVED_FAMILY_OCR_REVIEW_PROFILE=v1  # opt-in AR-042/IOS2-072/IOS3-075 OCR review; requires OCR layout v6 and other OCR review flags unset
# INSPECTOR_SITE_TEP_AREA_REVIEW_PROFILE=v1  # opt-in PZ-001/SPZU-026/SPZU-027 text review; separate from OCR review selectors
# INSPECTOR_SITE_GP_CONTEXT_REVIEW_PROFILE=v1  # opt-in SPZU-029/032/033/035/036 text review; separate from other review selectors
# INSPECTOR_SITE_GP_TABLE_ROW_REVIEW_PROFILE=v1  # opt-in SPZU-029/032 block-adjacency navigation; row association unverified
# INSPECTOR_EQUIPMENT_SPEC_REVIEW_PROFILE=v1  # opt-in IOS4-077/079 and PPM-112 equipment text navigation; all ABSTAIN
# INSPECTOR_MATERIAL_CLASS_REVIEW_PROFILE=v1  # opt-in KR-056/057/066 material text navigation; actual protection not established
# INSPECTOR_UNRESOLVED_CONFIG_REVIEW_PROFILE=v1  # opt-in config-pinned 19-code review-only text navigation; no findings or coverage
# INSPECTOR_UNRESOLVED_CONFIG_REVIEW_PROFILE=v2  # alternative opt-in 10-code approval/safety review; no findings or coverage
# INSPECTOR_UNRESOLVED_CONFIG_REVIEW_PROFILE=v3  # alternative opt-in 7-code network topology navigation; no findings or coverage
# INSPECTOR_LAYER_ASSEMBLY_REVIEW_PROFILE=v1  # opt-in road/roof/wall layer neighborhood proposals; no typed thickness or findings
# INSPECTOR_KR065_OPENING_REVIEW_PROFILE=v1  # opt-in KR-065 opening label navigation; no contour association or findings
PZ002_MAX_OCR_PAGES=2
PZ002_MAX_TABLE_PAGES=8
PZ002_MAX_TABLE_OCR_PAGES=2
SERVER_GPU_DEVICE=0
VLM_PORT=8101
DOCUMENT_AI_PORT=8090
EMBEDDING_PORT=8102
SERVER_EMBEDDING_BATCH_SIZE=8
MODEL_STORE_SAFETY_BYTES=5368709120
SERVER_GPU_MIN_TOTAL_MIB=78000
SERVER_DOCUMENT_MEMORY_LIMIT=32g
SERVER_VLM_MEMORY_LIMIT=48g
SERVER_EMBEDDING_MEMORY_LIMIT=8g
