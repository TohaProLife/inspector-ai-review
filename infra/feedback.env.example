# Copy to infra/feedback.env (gitignored), replace every REPLACE value with a
# separate random secret. This profile reuses existing ordinary model services.
HOST_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=inspector
POSTGRES_USER=inspector
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
RABBITMQ_USER=inspector
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MINIO_ROOT_USER=inspector
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_SECRET
INTERNAL_WORKER_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
API_PORT=24101
WEB_PORT=28082
POSTGRES_PORT=25434
RABBITMQ_PORT=25674
RABBITMQ_MANAGEMENT_PORT=35674
REDIS_PORT=26380
MINIO_API_PORT=29002
MINIO_CONSOLE_PORT=29003
INSPECTOR_OPEN_WORKSPACE=1
SESSION_COOKIE_SECURE=0
ALLOWED_ORIGINS=http://localhost:28082,http://127.0.0.1:28082
FEEDBACK_DOCUMENT_NETWORK=inspector-feedback-20261017-document-ai
FEEDBACK_VLM_NETWORK=inspector-ai-homeserver-smoke_visual-vlm-runtime
