RABBITMQ_URL=amqp://inspector:inspector@localhost:5672
# Отдельный случайный secret не короче 32 символов; одинаковый только у API и worker.
INTERNAL_WORKER_TOKEN=replace-with-random-worker-token-32chars
WORKER_HEARTBEAT_SECONDS=20
OUTBOX_METRICS_PORT=9465
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=inspector-documents
S3_ACCESS_KEY=inspector
S3_SECRET_KEY=change-me-now
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
