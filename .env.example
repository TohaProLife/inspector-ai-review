API_PORT=4100
VITE_API_URL=http://localhost:4100/api
DATABASE_URL=postgresql://inspector:inspector@localhost:5432/inspector
INSPECTOR_ORGANIZATION_SLUG=local
INSPECTOR_ORGANIZATION_NAME=Локальная организация
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
SESSION_COOKIE_SECURE=0
# INSPECTOR_USER_LOGIN=local-inspector
# INSPECTOR_USER_DISPLAY_NAME=Локальный инспектор
# INSPECTOR_USER_PASSWORD=provide-at-runtime-only
