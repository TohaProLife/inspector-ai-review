{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspector-ai.local/schemas/local-evaluation-envelope-v1.schema.json",
  "title": "LOCAL evaluation provenance envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "sealed", "runId", "sourceManifestSha256", "submission"],
  "properties": {
    "schemaVersion": { "const": "local-evaluation-envelope-v1" },
    "mode": { "const": "NORMAL" },
    "sealed": { "const": true },
    "runId": { "type": "string", "minLength": 1 },
    "sourceManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "submission": { "type": "object" }
  }
}
